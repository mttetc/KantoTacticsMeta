{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/revalidate",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/revalidate",
      "schedule": "20 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(sd|thumb|items|types)/(.*)\\.(gif|png|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!data/snapshot'"
}
